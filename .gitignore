# ==============================================================================
# Git Ignore - Universal Sentence Refiner
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging build outputs
build/
dist/
*.deb
*.rpm
*.tar.gz
*.zip
*.egg
*.egg-info/
.eggs/

# IDEs & Code Editors
.idea/
*.iml
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/
*.sublime-project
*.sublime-workspace

# Operating System generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Virtual environments
.env
.env.*
*.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Local runtime data, pid files, sockets & config caches
.config/
*.pid
*.sock
history.json
config.json
*.sqlite
*.db

# Logs and temporary files
*.log
*.tmp
*.bak
/tmp/

# Testing & code coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
